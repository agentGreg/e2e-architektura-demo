{
  "name": "e2e-architektura-demo",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "preinstall": "node --disable-warning=ExperimentalWarning scripts/check-node.mjs",
    "check:node": "node --disable-warning=ExperimentalWarning scripts/check-node.mjs",
    "dev": "node --disable-warning=ExperimentalWarning scripts/dev.mjs",
    "dev:shop": "node --disable-warning=ExperimentalWarning apps/shop/src/server.mjs",
    "dev:backoffice": "node --disable-warning=ExperimentalWarning apps/backoffice/src/server.mjs",
    "db:reset": "node --disable-warning=ExperimentalWarning scripts/db-reset.mjs",
    "seed:check": "node --disable-warning=ExperimentalWarning scripts/seed-check.mjs",
    "test": "node --disable-warning=ExperimentalWarning scripts/check-node.mjs && pnpm -r --no-bail --workspace-concurrency=1 test",
    "test:shop": "pnpm --filter e2e-shop test",
    "test:backoffice": "pnpm --filter e2e-backoffice test",
    "test:smoke": "node --disable-warning=ExperimentalWarning scripts/check-node.mjs && pnpm --filter e2e-shop exec playwright test --grep @smoke --workers=1",
    "demo:failures": "node --disable-warning=ExperimentalWarning scripts/demo-failures.mjs",
    "test:shard": "node --disable-warning=ExperimentalWarning scripts/run-shards.mjs --total 2 --app shop",
    "report:merge": "node --disable-warning=ExperimentalWarning scripts/merge-reports.mjs",
    "typecheck": "tsc -p packages/test-core && tsc -p e2e/shop && tsc -p e2e/backoffice",
    "clean": "node --disable-warning=ExperimentalWarning scripts/clean.mjs",
    "offline:pack": "node --disable-warning=ExperimentalWarning scripts/offline-pack.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0"
  }
}
