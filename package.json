{
  "name": "e2e-architektura-demo",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "check:node": "node scripts/check-node.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:shop": "node apps/shop/src/server.mjs",
    "dev:backoffice": "node apps/backoffice/src/server.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "seed:check": "node scripts/seed-check.mjs",
    "test": "node scripts/check-node.mjs && pnpm test:shop && pnpm test:backoffice",
    "test:shop": "pnpm --filter e2e-shop test",
    "test:backoffice": "pnpm --filter e2e-backoffice test",
    "test:smoke": "node scripts/check-node.mjs && pnpm --filter e2e-shop exec playwright test --grep @smoke --workers=1",
    "demo:failures": "node scripts/demo-failures.mjs",
    "test:shard": "node scripts/run-shards.mjs --total 2 --app shop",
    "report:merge": "node scripts/merge-reports.mjs",
    "typecheck": "tsc -p packages/test-core && tsc -p e2e/shop && tsc -p e2e/backoffice",
    "clean": "node scripts/clean.mjs",
    "offline:pack": "node scripts/offline-pack.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0"
  }
}
